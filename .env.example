# ===== 项目根路径（compose 变量替换 & 同路径挂载用，必须是宿主机绝对路径）=====
LIANGHUA_ROOT=/home/zk/code/lianghua

# ===== RD-Agent LLM 配置 =====
# 对话模型：DeepSeek 官方 API（也可换 openai 兼容的任意 LiteLLM 支持模型）
CHAT_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=__填你的_DEEPSEEK_KEY__

# Embedding 模型：DeepSeek 无 embedding，用硅基流动 BAAI/bge-m3
EMBEDDING_MODEL=litellm_proxy/BAAI/bge-m3
LITELLM_PROXY_API_KEY=__填你的_硅基流动_KEY__
LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1

# 若使用带思维链的推理模型（如 deepseek-reasoner），取消下行注释
# REASONING_THINK_RM=True

# ===== OpenAI 备选（二选一，注释掉上面的 DeepSeek 段）=====
# CHAT_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=__填你的_OPENAI_KEY__
# OPENAI_API_BASE=https://api.openai.com/v1
